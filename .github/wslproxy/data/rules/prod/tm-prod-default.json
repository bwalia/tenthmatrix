{
  "id": "tm-prod-default",
  "name": "tm-prod-default",
  "priority": 1,
  "profile_id": "prod",
  "rules_tags": [
    "tenthmatrix",
    "prod"
  ],
  "servers": [
    "host:int.tenthmatrix.com",
    "host:test.tenthmatrix.com",
    "host:acc.tenthmatrix.com"
  ],
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with"
    },
    "response": {
      "code": 305,
      "redirect_uri": "193.237.176.232:8888",
      "strip_path": false,
      "routing": {
        "mode": "least_conn"
      },
      "backends": [
        {
          "address": "193.237.176.232:8888",
          "weight": 100,
          "label": "k3s1 Traefik ingress; routes by Host header to the per-env tm-frontend (tenthmatrix-website)"
        }
      ]
    }
  }
}
