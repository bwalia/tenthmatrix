{
  "id": "tm-prod-default",
  "name": "tm-prod-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": [
    "tenthmatrix-website",
    "prod"
  ],
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with"
    },
    "response": {
      "code": 305,
      "redirect_uri": "193.237.176.232:8888",
      "strip_path": false,
      "backends": [
        {
          "address": "193.237.176.232:8888",
          "weight": 100,
          "label": "k3s ingress entry for *.tenthmatrix.com (same backend as the Workstation hosts); Traefik routes by Host header to the per-env tm-frontend Service"
        }
      ],
      "routing": {
        "mode": "least_conn"
      }
    }
  },
  "servers": [
    "host:int.tenthmatrix.com",
    "host:test.tenthmatrix.com",
    "host:acc.tenthmatrix.com",
    "host:www.tenthmatrix.com",
    "host:tenthmatrix.com"
  ]
}
