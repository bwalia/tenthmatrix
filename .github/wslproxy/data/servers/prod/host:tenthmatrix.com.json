{
  "listens": [
    {
      "listen": "80"
    }
  ],
  "cache_enabled": false,
  "access_log": "logs/tenthmatrix.com.access.log",
  "error_log": "logs/tenthmatrix.com.error.log",
  "ssl_enabled": true,
  "index": "index.html",
  "root": "/var/www/html",
  "proxy_server_name": "tenthmatrix-website.s3-website.eu-west-2.amazonaws.com",
  "id": "host:tenthmatrix.com",
  "match_cases": {},
  "ssl_email": "admin@tenthmatrix.com",
  "ssl_auto_renew": true,
  "ssl_force_https": true,
  "ssl_staging": false,
  "config_status": true,
  "server_name": "tenthmatrix.com",
  "custom_headers": {},
  "profile_id": "prod",
  "rules": "tm-website-s3-proxy",
  "dns_record_type": "CNAME",
  "dns_cname_target": "lon1.pop0.uk"
}
