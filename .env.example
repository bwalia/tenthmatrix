# TenthMatrix website — environment template. Copy to .env.local for local dev.
# NEVER commit real values. In k3s, secrets come from Vault via the
# ExternalSecret (devops/VAULT-SECRETS.md); non-secret config from Helm appConfig.

# Canonical site origin (sitemap, robots, canonical URLs, JSON-LD).
SITE_URL=https://www.tenthmatrix.com

# --- CMS (server-side) -------------------------------------------------------
# Blog posts: committed JSON is the base layer; OpsAPI CMS posts from this
# namespace are overlaid on top (same slug → CMS wins).
#   GET {OPSAPI_URL}api/v2/public/cms/{WEBSITE_NAMESPACE}/posts
# OPSAPI_URL must end with a slash. In k3s it is the IN-CLUSTER service, not the
# public host. Leave empty locally to render the committed JSON only.
OPSAPI_URL=
WEBSITE_NAMESPACE=tenthmatrix
WEBSITE_CATEGORY=
# overlay (default) = git base + CMS on top; prefer = legacy either/or.
CMS_CONTENT_MODE=overlay
CMS_REVALIDATE_SECONDS=3600
CMS_FETCH_TIMEOUT_MS=5000
# HMAC secret for POST /api/revalidate (must match the OpsAPI CMS webhook secret).
REVALIDATE_SECRET=

# --- Lead form (browser) -----------------------------------------------------
# POST {base}/api/v2/public/leads/{NEXT_PUBLIC_LEADS_NAMESPACE}
# {base} is resolved from the page host (src/utils/opsapiEnv.mjs):
#   int./test./acc.tenthmatrix.com → https://{env}-api.tenthmatrix.com
#   www.tenthmatrix.com / apex      → https://api.tenthmatrix.com
# This var is only the fallback for other hosts (localhost, previews).
NEXT_PUBLIC_OPSAPI_URL=https://int-api.tenthmatrix.com
NEXT_PUBLIC_LEADS_NAMESPACE=tenthmatrix

# --- Secrets (Vault in k3s) --------------------------------------------------
CAPTCHA_SITE_KEY=
API_SECRET=
JWT_SECRET_KEY=
BUSINESS_CODE=
# OpsAPI API key (cms scope) for scripts/import-blogs-to-cms.mjs --apply and
# future publish scripts. Never needed by the running site.
OPSAPI_API_KEY=

# --- Runtime extras ----------------------------------------------------------
# Shared ISR cache across replicas (cache-handler.mjs); unset = per-pod LRU.
REDIS_URL=
# Likes/comments store (src/lib/engagement.js); default ./.data/engagement.
ENGAGEMENT_STORE_DIR=
# true on int/test/acc so robots.txt disallows everything.
ROBOTS_DISALLOW_ALL=

# Enquiry chat (/api/chat). Unset = assistant offline, widget hidden.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
CHAT_EFFORT=low
