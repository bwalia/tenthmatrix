apps/vpn10x-apple/build/
apps/vpn10x-apple/DerivedData/
**/xcuserdata/
deploy/compose/data/

# The bundled CLI is built by apps/vpn10x-desktop/Makefile, never committed.
apps/vpn10x-desktop/src-tauri/binaries/

# Generated deployment secrets cached by deploy/scripts/vault-load-secrets.sh.
deploy/.secrets/
