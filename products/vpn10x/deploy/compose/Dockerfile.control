# syntax=docker/dockerfile:1
FROM rust:1.90-bookworm AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations
RUN cargo build --release -p vpn10x-control

# Distroless: no shell, no package manager, no busybox. A process that is
# compromised has nothing to pivot with, and the image carries no CVEs from
# userland it never uses.
FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=builder /src/target/release/vpn10x-control /usr/local/bin/vpn10x-control
# 65532 is distroless' `nonroot`; the Helm chart's securityContext expects it.
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/vpn10x-control"]
